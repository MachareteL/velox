{
  "name": "velox-whatsapp-saas-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo para automação WhatsApp Velox SaaS",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:types": "npm run build --workspace=packages/types",
    "build:database": "npm run build --workspace=packages/database",
    "build:worker": "npm run build --workspace=apps/worker",
    "build:web": "npm run build --workspace=apps/web",
    "build": "npm run build:types && npm run build:database && npm run build:worker && npm run build:web",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev": "concurrently \"npm:dev:worker\" \"npm:dev:web\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "puppeteer@24.38.0": true
  }
}

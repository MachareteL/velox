      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Volume de Logs por Nível (Info / Warn / Error)",
      "type": "timeseries",
      "datasource": "Loki",
      "targets": [
        {
          "datasource": "Loki",
          "editorMode": "code",
          "expr": "sum by (level) (count_over_time({app=\"velox-worker\"} | json | level=~\"$level\" | tenantId=~\"$tenantId\" | sessionId=~\"$sessionId\" | operationId=~\"$operationId\" | socketId=~\"$socketId\" | category=~\"$category\" | event=~\"$event\" [$__interval]))",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 4 },
      "id": 2,
      "title": "Logs em Tempo Real - Velox Worker",
      "type": "logs",
      "datasource": "Loki",
      "targets": [
        {
          "datasource": "Loki",
          "editorMode": "code",
          "expr": "{app=\"velox-worker\"} | json | level=~\"$level\" | tenantId=~\"$tenantId\" | sessionId=~\"$sessionId\" | operationId=~\"$operationId\" | socketId=~\"$socketId\" | category=~\"$category\" | event=~\"$event\" |~ \"(?i)$search\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "showTime": true,
        "showCommonLabels": false
      }
    }
  ],
  "refresh": "5s",
